  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0",
    "eslint": "^10.0.3",
    "@eslint/js": "^10.0.1",
    "typescript-eslint": "^8.0.0",
    "@types/express": "^4.17.21",
    "cross-env": "^7.0.3"
  }
}
